# -*- coding: utf-8 -*-
{
  "mcpServers": {
    "browser": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest"]
    },
    "filesystem": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "D:/AI_Cluster/NAI"]
    },
    "http-example": {
      "type": "http",
      "url": "http://127.0.0.1:8000/mcp"
    }
  }
}
